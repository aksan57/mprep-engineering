{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    { "source": "/models/(.*)\\.glb", "headers": [{ "key": "Content-Type", "value": "model/gltf-binary" }, { "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
